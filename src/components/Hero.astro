---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { hero, ui, site, type Lang } from '../content/content';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;

// Portrait : déposer src/assets/photos/profil.png (idéalement détouré, fond transparent) — ou .jpg/.webp
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/profil.{png,webp,jpg,jpeg}', { eager: true });
const photo = Object.values(found)[0]?.default;
const roles = hero.roles[lang];
const word = `${hero.marquee} — `;
---
<section class="hero" id="top">
  <!-- nom géant en contour qui défile -->
  <div class="marquee" aria-hidden="true">
    <div class="track"><span>{word}</span><span>{word}</span></div>
  </div>

  {photo && (
    <div class="portrait">
      <Picture src={photo} alt={hero.photoAlt[lang]} widths={[360, 560, 760]} sizes="(min-width: 900px) 520px, 90vw"
        formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
    </div>
  )}

  <div class:list={['container overlay', { centered: !photo }]}>
    <div class="intro" data-reveal>
      <p class="eyebrow">{hero.hello[lang]}</p>
      <h1>{hero.firstName} <span>{hero.lastName}</span></h1>
      <p class="role">
        <span class="sr-only">{roles.join(', ')}</span>
        <span aria-hidden="true" data-typer={JSON.stringify(roles)}>{roles[0]}</span>
      </p>
      <div class="actions">
        <a class="btn btn-solid btn-caps" href="#contact">{ui.hire[lang]} <Icon name="arrow" /></a>
        <a class="btn btn-caps" href={site.cvFile} download><Icon name="download" /> CV</a>
      </div>
    </div>
  </div>

  <a class="scroll" href="#work">{hero.scrollDown[lang]}</a>
</section>

<style>
  .hero { position: relative; min-height: 100svh; padding: 0; overflow: hidden; display: grid; }
  .marquee { position: absolute; left: 0; right: 0; top: 50%; translate: 0 -62%; overflow: hidden; pointer-events: none; }
  .track { display: flex; width: max-content; animation: slide 38s linear infinite; }
  .track span {
    font-size: clamp(6rem, 3rem + 15vw, 17rem); font-weight: 600; letter-spacing: -0.01em; line-height: 1; white-space: nowrap;
    color: transparent; -webkit-text-stroke: 1.5px var(--line-strong); padding-right: 0.3em;
  }
  @keyframes slide { to { transform: translateX(-50%); } }

  .portrait { position: absolute; left: 50%; bottom: 0; translate: -50% 0; width: min(92vw, 560px); height: min(82svh, 760px); z-index: 1;
    display: flex; align-items: flex-end; justify-content: center; }
  .portrait :global(picture), .portrait :global(img) { height: 100%; width: auto; object-fit: contain; object-position: bottom; }
  /* sans portrait : carte de présentation centrée sur le nom qui défile */
  .overlay.centered { align-self: center; display: flex; justify-content: center; padding-top: 5rem; }
  .centered .intro { max-width: 460px; text-align: center; padding: 1.6rem 1.8rem; }
  .centered h1 { font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem); }
  .centered .actions { justify-content: center; }

  .overlay { position: relative; z-index: 2; align-self: end; padding-bottom: clamp(1.5rem, 5vh, 3rem); pointer-events: none; }
  .intro { pointer-events: auto; max-width: 340px; padding: 1.1rem 1.2rem; border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 78%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--line); box-shadow: var(--shadow); }
  .intro .eyebrow { margin-bottom: 0.3rem; }
  h1 { font-size: 1.35rem; letter-spacing: -0.02em; }
  h1 span { display: block; }
  .role { margin: 0.4rem 0 0.9rem; font-family: var(--mono); font-size: 0.8rem; color: var(--accent); min-height: 1.4em; }
  .role [data-typer]::after { content: '_'; animation: caret 1s steps(1) infinite; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .actions .btn { min-height: 40px; padding: 0.5rem 1rem; }

  .scroll { position: absolute; right: 1.2rem; bottom: 2rem; z-index: 2; writing-mode: vertical-rl; font-family: var(--mono); font-size: 0.62rem;
    letter-spacing: 0.3em; text-transform: uppercase; text-decoration: none; color: var(--muted); display: flex; align-items: center; gap: 0.8rem; }
  .scroll::after { content: ''; width: 1px; height: 48px; background: currentColor; }

  @media (max-width: 700px) {
    .hero { display: block; min-height: auto; padding-top: 5.5rem; }
    .marquee { top: 36%; }
    .portrait { position: relative; left: auto; translate: none; width: 100%; height: 56svh; margin-inline: auto; }
    .overlay { margin-top: -2rem; padding-bottom: 1.5rem; }
    .intro { max-width: none; }
    .scroll { display: none; }
  }
</style>
